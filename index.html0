            <h1 class="text-4xl md:text-5xl font-bold mb-4">億欣報關行</h1>
            <p class="text-lg md:text-xl text-blue-200">跨境電商平台貨物通關夥伴</p>
        </section>

        <!-- 通關狀態查詢 Section -->
        <section id="search" class="py-16 md:py-24 bg-white">
            <div class="container mx-auto px-6">
                <h2 class="text-3xl font-bold text-center mb-12 text-gray-900">通關狀態查詢</h2>
                <div class="max-w-3xl mx-auto bg-gray-50 rounded-xl shadow-lg overflow-hidden">
                    <!-- 嵌入 search1.php -->
                    <!-- 確保 search1.php 檔案與此 HTML 檔案位於同一伺服器路徑下 -->
                    <iframe src="search1.php" class="w-full h-[600px] border-0" title="通關狀態查詢"></iframe>
                </div>
            </div>
        </section>

        <!-- 問題集 Section -->
        <section id="faq" class="py-16 md:py-24 bg-gray-50">
            <div class="container mx-auto px-6 max-w-4xl">
                <h2 class="text-3xl font-bold text-center mb-12 text-gray-900">常見問題集</h2>
                <div class="space-y-4" id="faq-accordion">
                    <!-- FAQ Item 1 -->
                    <div class="bg-white rounded-lg shadow-md">
                        <button class="accordion-header w-full flex justify-between items-center text-left p-5 font-semibold text-gray-800 focus:outline-none">
                            <span>什麼是 EZ WAY 易利委？為什麼我需要註冊？</span>
                            <svg class="w-6 h-6 transform transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <div class="accordion-content">
                            <p class="p-5 pt-0 text-gray-600">EZ WAY 易利委是財政部關務署推出的實名認證 APP，為配合海關進口報關的實名委任政策。所有進口快遞貨物的收貨人都需要完成實名認證，以確保貨物能順利通關。</p>
                        </div>
                    </div>
                    <!-- FAQ Item 2 -->
                    <div class="bg-white rounded-lg shadow-md">
                        <button class="accordion-header w-full flex justify-between items-center text-left p-5 font-semibold text-gray-800 focus:outline-none">
                            <span>我的貨物查詢無資料怎麼辦？</span>
                             <svg class="w-6 h-6 transform transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <div class="accordion-content">
                            <p class="p-5 pt-0 text-gray-600">如果您的貨物查詢後無通關資料，請先看你的易立委是否未按[申報相符]，若已經有按請等待1~2日會有通關訊息，因為貨物通關是需要安排通關順序的，請您耐心等候。</p>
                        </div>
                    </div>
                    <!-- FAQ Item 3 -->
                    <div class="bg-white rounded-lg shadow-md">
                        <button class="accordion-header w-full flex justify-between items-center text-left p-5 font-semibold text-gray-800 focus:outline-none">
                            <span>進口稅金是如何計算的？</span>
                             <svg class="w-6 h-6 transform transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <div class="accordion-content">
                            <p class="p-5 pt-0 text-gray-600">進口稅金主要包含進口稅與營業稅。進口稅的計算方式為：完稅價格 × 進口稅率。營業稅的計算方式為：（完稅價格＋進口稅）× 營業稅率（5%）。完稅價格是指貨物本身價格、國際運費及保險費的總和。</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 文件下載 Section -->
        <section id="downloads" class="py-16 md:py-24 bg-white">
            <div class="container mx-auto px-6 max-w-4xl">
                <h2 class="text-3xl font-bold text-center mb-12 text-gray-900">文件下載</h2>
                <div class="grid md:grid-cols-2 gap-6">
                    <!-- Download Item 1 -->
                    <div class="bg-gray-50 p-6 rounded-lg shadow-sm flex justify-between items-center">
                        <div>
                            <h3 class="font-semibold text-lg">個案委任書</h3>
                            <p class="text-gray-600 text-sm">簡報轉正式報關所需之表格。</p>
                        </div>
                        <a href="download/01.doc" download class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition duration-300">下載</a>
                    </div>
                    <!-- Download Item 2 -->
                    <div class="bg-gray-50 p-6 rounded-lg shadow-sm flex justify-between items-center">
                        <div>
                            <h3 class="font-semibold text-lg">個人自用切結書</h3>
                            <p class="text-gray-600 text-sm">申請個人自用表格。</p>
                        </div>
                        <a href="download/02.docx" download class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition duration-300">下載</a>
                    </div>
		    <!-- Download Item 3 -->
                    <div class="bg-gray-50 p-6 rounded-lg shadow-sm flex justify-between items-center">
                        <div>
                            <h3 class="font-semibold text-lg">放棄書</h3>
                            <p class="text-gray-600 text-sm">申請放棄所需表格。</p>
                        </div>
                        <a href="download/04.pdf" download class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition duration-300">下載</a>
                    </div>
                   <!-- Download Item 4 -->
                    <div class="bg-gray-50 p-6 rounded-lg shadow-sm flex justify-between items-center">
                        <div>
                            <h3 class="font-semibold text-lg">貨物部分放行及放棄申請書</h3>
                            <p class="text-gray-600 text-sm">申請部分所需表格。</p>
                        </div>
                        <a href="download/03.doc" download class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition duration-300">下載</a>
                    </div>
 
                </div>
            </div>
        </section>

        <!-- 聯繫我們 Section -->
        <section id="contact" class="py-16 md:py-24 bg-gray-800 text-white">
            <div class="container mx-auto px-6">
                <h2 class="text-3xl font-bold text-center mb-12">聯繫我們</h2>
                <div class="grid md:grid-cols-2 gap-12">
                    <!-- Contact Info -->
                    <div class="space-y-6">
                        <div>
                            <h3 class="text-xl font-semibold mb-2 text-blue-300">公司資訊</h3>
                            <p>地址：806 高雄市前鎮區鎮港路18號</p>
                            <p>電話：(07) </p>
                            <p>Email: jason_lee@galloptek.com</p>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold mb-2 text-blue-300">營業時間</h3>
                            <p>週一至週五：09:00 - 17:00</p>
                            <p>週六、週日及國定假日休息</p>
                        </div>
                    </div>
                    <!-- Contact Form -->
                    <div>
                        <h3 class="text-xl font-semibold mb-4 text-blue-300">線上留言</h3>
                        <form id="contact-form" class="space-y-4">
                            <div>
                                <label for="name" class="block mb-1 font-medium">您的中文姓名</label>
                                <input type="text" id="name" name="name" required class="w-full p-2 rounded-md bg-gray-700 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label for="phone" class="block mb-1 font-medium">手機號碼</label>
                                <input type="tel" id="phone" name="phone" required class="w-full p-2 rounded-md bg-gray-700 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <p class="text-xs text-gray-400 mt-1">請提供申報人的中文姓名及手機號碼以便確認是本人</p>
                            </div>
                            <div>
                                <label for="email" class="block mb-1 font-medium">您的 Email</label>
                                <input type="email" id="email" name="email" required class="w-full p-2 rounded-md bg-gray-700 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                             <div>
                                <label for="house_bl" class="block mb-1 font-medium">分提單號 (House No.)</label>
                                <input type="text" id="house_bl" name="house_bl" class="w-full p-2 rounded-md bg-gray-700 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label for="inquiry_type" class="block mb-1 font-medium">問題類型</label>
                                <select id="inquiry_type" name="inquiry_type" required class="w-full p-2 rounded-md bg-gray-700 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="" disabled selected>請選擇問題類型...</option>
                                    <option value="預委任修改">預委任修改</option>
                                    <option value="轉正報問題">轉正報問題</option>
                                    <option value="稅金問題">稅金問題</option>
                                    <option value="其他">其他</option>
                                </select>
                            </div>
                            <div>
                                <label for="message" class="block mb-1 font-medium">留言內容</label>
                                <textarea id="message" name="message" rows="5" required class="w-full p-2 rounded-md bg-gray-700 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                            </div>
                            <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-md hover:bg-blue-700 transition duration-300 font-bold">送出留言</button>
                        </form>
                        <!-- 成功與錯誤訊息的容器 -->
                        <div id="form-success-message" class="hidden mt-4 p-4 bg-green-600 text-white rounded-md"></div>
                        <div id="form-error-message" class="hidden mt-4 p-4 bg-red-600 text-white rounded-md"></div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 text-center py-6">
        <p>&copy; 2024 億欣報關行. All Rights Reserved.</p>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Mobile menu toggle
            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');
            mobileMenuButton.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            // Close mobile menu when a link is clicked
            const mobileLinks = mobileMenu.querySelectorAll('a');
            mobileLinks.forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                });
            });

            // FAQ Accordion
            const accordionHeaders = document.querySelectorAll('.accordion-header');
            accordionHeaders.forEach(header => {
                header.addEventListener('click', () => {
                    const content = header.nextElementSibling;
                    const icon = header.querySelector('svg');

                    // Close all other accordions
                    document.querySelectorAll('.accordion-content').forEach(item => {
                        if (item !== content) {
                            item.style.maxHeight = null;
                            item.previousElementSibling.querySelector('svg').classList.remove('rotate-180');
                        }
                    });

                    // Toggle current accordion
                    if (content.style.maxHeight) {
                        content.style.maxHeight = null;
                        icon.classList.remove('rotate-180');
                    } else {
                        content.style.maxHeight = content.scrollHeight + "px";
                        icon.classList.add('rotate-180');
                    }
                });
            });

            // ** 更新後的聯繫表單提交邏輯 **
            const contactForm = document.getElementById('contact-form');
            const successMessage = document.getElementById('form-success-message');
            const errorMessage = document.getElementById('form-error-message');
            
            contactForm.addEventListener('submit', function (e) {
                e.preventDefault(); // 防止表單的默認提交行為

                const submitButton = contactForm.querySelector('button[type="submit"]');
                const originalButtonText = submitButton.innerHTML;
                submitButton.innerHTML = '傳送中...';
                submitButton.disabled = true;

                // 隱藏舊的訊息
                successMessage.classList.add('hidden');
                errorMessage.classList.add('hidden');

                const formData = new FormData(contactForm);

                // 使用 Fetch API 將表單資料發送到後端 PHP
                fetch('send_mail.php', {
                    method: 'POST',
                    body: formData
                })
                .then(response => {
                    // 檢查響應是否成功
                    if (!response.ok) {
                        // 如果伺服器返回錯誤（如 400, 500），則拋出錯誤以便 catch 區塊捕獲
                        return response.json().then(err => { throw new Error(err.message || '伺服器發生錯誤。') });
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.status === 'success') {
                        successMessage.textContent = data.message;
                        successMessage.classList.remove('hidden');
                        contactForm.reset();
                        setTimeout(() => {
                            successMessage.classList.add('hidden');
                        }, 5000); // 5秒後隱藏成功訊息
                    } else {
                        // 處理 PHP 腳本內部回報的錯誤
                        throw new Error(data.message || '發生未知的錯誤。');
                    }
                })
                .catch(error => {
                    // 捕獲網路錯誤或從 then 區塊拋出的錯誤
                    errorMessage.textContent = error.message;
                    errorMessage.classList.remove('hidden');
                     setTimeout(() => {
                        errorMessage.classList.add('hidden');
                    }, 5000); // 5秒後隱藏錯誤訊息
                })
                .finally(() => {
                    // 無論成功或失敗，都恢復按鈕的狀態
                    submitButton.innerHTML = originalButtonText;
                    submitButton.disabled = false;
                });
            });
        });
    </script>

</body>
</html>

