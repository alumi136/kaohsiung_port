<!DOCTYPE html>
<html lang="zh-Hant" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>億欣報關行 - 專業海運快遞通關服務</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        /* 使用 Noto Sans TC 作為主要中文字體，Inter 作為英數字體 */
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
        }
        /* 確保 Iframe 在手機上有好的顯示效果 */
        .responsive-iframe-container {
            position: relative;
            overflow: hidden;
            padding-top: 120%; /* 根據 search1.php 內容高度調整比例 */
        }
        .responsive-iframe-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }
        /* FAQ 收合效果 */
        .accordion-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800">

    <!-- Header & Navigation -->
    <header class="bg-white shadow-md sticky top-0 z-50">
        <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
            <div class="text-2xl font-bold text-blue-900">
                億欣報關行
            </div>
            <div class="hidden md:flex space-x-8">
                <a href="#search" class="text-gray-600 hover:text-blue-700 transition duration-300">通關狀態查詢</a>
                <a href="#faq" class="text-gray-600 hover:text-blue-700 transition duration-300">問題集</a>
                <a href="#downloads" class="text-gray-600 hover:text-blue-700 transition duration-300">文件下載</a>
                <a href="#contact" class="text-gray-600 hover:text-blue-700 transition duration-300">聯繫我們</a>
            </div>
            <div class="md:hidden">
                <button id="mobile-menu-button" class="text-gray-600 focus:outline-none">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
                </button>
            </div>
        </nav>
        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden px-6 pt-2 pb-4">
            <a href="#search" class="block py-2 text-gray-600 hover:text-blue-700">通關狀態查詢</a>
            <a href="#faq" class="block py-2 text-gray-600 hover:text-blue-700">問題集</a>
            <a href="#downloads" class="block py-2 text-gray-600 hover:text-blue-700">文件下載</a>
            <a href="#contact" class="block py-2 text-gray-600 hover:text-blue-700">聯繫我們</a>
        </div>
