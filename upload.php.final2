<?php
// 引入 Composer 的 autoloader，用於載入 PhpSpreadsheet
require 'excel/vendor/autoload.php';

use PhpOffice\PhpSpreadsheet\IOFactory;
use PhpOffice\PhpSpreadsheet\Shared\Date;

// --- 日誌功能 ---
/**
 * 將錯誤訊息寫入指定的日誌檔案。
 * @param string $message 要記錄的訊息。
 */
function write_log($message) {
    $log_file = '/var/log/daily_outbound.log'; // Log 檔案路徑
    $timestamp = date('Y-m-d H:i:s');
    // 格式化日誌訊息，包含時間戳記和換行符
    $formatted_message = "[{$timestamp}] " . $message . PHP_EOL;
    // 將訊息附加到日誌檔案，如果檔案不存在則會自動建立
    // 注意：PHP需要有寫入此目錄的權限
    file_put_contents($log_file, $formatted_message, FILE_APPEND);
}

/**
 * 建立一個更穩健的日期解析函式來處理 Excel 中的多種日期格式
 * @param mixed $value 儲存格的值
 * @return string|null 格式化後的 'Y-m-d H:i:s' 字串，或在失敗時返回 null
 * @throws Exception 如果日期格式無法辨識
 */
function parse_date_value($value) {
    if (empty($value)) {
        return null;
    }
    // 如果是數字，則假定為 Excel 的時間戳記
    if (is_numeric($value)) {
        return Date::excelToDateTimeObject($value)->format('Y-m-d H:i:s');
    }
    // 如果是字串，嘗試用 strtotime 解析
    if (is_string($value)) {
        $timestamp = strtotime($value);
        if ($timestamp !== false) {
            return date('Y-m-d H:i:s', $timestamp);
        }
    }
    // 如果以上方法都失敗，則拋出例外
    throw new Exception("無法辨識的日期格式");
}


// --- 資料庫連線設定 ---
$servername = "localhost";
$username = "alumi136";
$password = "Alumi!36";
$dbname = "kaohsiung_port_db";

$user_message = '';
$message_type = '';
$import_errors = []; // 存放給使用者看的匯入錯誤訊息

// 檢查表單是否已提交
if ($_SERVER["REQUEST_METHOD"] == "POST") {
    // 優先處理 "每日進出口資料" 的檔案
    if (isset($_FILES['import_export_file']) && $_FILES['import_export_file']['error'] == UPLOAD_ERR_OK) {
        
        $file_tmp_path = $_FILES['import_export_file']['tmp_name'];
        $file_name = htmlspecialchars(basename($_FILES['import_export_file']['name']));
        $file_ext = strtolower(pathinfo($file_name, PATHINFO_EXTENSION));

        // 檢查檔案類型是否為 xlsx, xls 或 csv
        if (!in_array($file_ext, ['xlsx', 'xls', 'csv'])) {
            $user_message = "檔案格式不支援。請上傳 .xlsx, .xls 或 .csv 檔案。";
            $message_type = 'warn';
        } else {
            $conn = new mysqli($servername, $username, $password, $dbname);
            if ($conn->connect_error) {
                $error_msg = "資料庫連線失敗: " . $conn->connect_error;
                write_log($error_msg);
                $user_message = "系統錯誤：無法連線到資料庫。請聯繫管理員。";
                $message_type = 'error';
            } else {
                $conn->set_charset("utf8mb4");
                $inserted_rows = 0;
                $updated_rows = 0;
                $processed_rows = 0;

                $conn->begin_transaction();
                
                try {
                    // 使用 PhpSpreadsheet 讀取檔案
                    $spreadsheet = IOFactory::load($file_tmp_path);
                    $worksheet = $spreadsheet->getActiveSheet();
                    $highestRow = $worksheet->getHighestRow();
                    
                    // 準備 SQL 語句
                    $check_sql = "SELECT id FROM daily_outbound WHERE master_no = ? AND house_no = ?";
                    $insert_sql = "INSERT INTO daily_outbound (declaration_no, master_no, house_no, weight, total_packages, packages_in, packages_out, clearance_method, declaration_type, carrier_id, route, storage_in_datetime, storage_out_datetime, status, customer_name) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";
                    $update_sql = "UPDATE daily_outbound SET declaration_no = ?, weight = ?, total_packages = ?, packages_in = ?, packages_out = ?, clearance_method = ?, declaration_type = ?, carrier_id = ?, route = ?, storage_in_datetime = ?, storage_out_datetime = ?, status = ?, customer_name = ? WHERE master_no = ? AND house_no = ?";

                    $check_stmt = $conn->prepare($check_sql);
                    $insert_stmt = $conn->prepare($insert_sql);
                    $update_stmt = $conn->prepare($update_sql);

                    if ($check_stmt === false || $insert_stmt === false || $update_stmt === false) {
                        throw new Exception("SQL 預備語句失敗: " . $conn->error);
                    }

                    // 從第二行開始讀取 (忽略標頭)
                    for ($row = 2; $row <= $highestRow; $row++) {
                        $processed_rows++;
                        $rowData = [];
                        // 從 A 欄讀取到 O 欄 (15個欄位)
                        for ($col = 'A'; $col <= 'O'; $col++) {
                            $rowData[] = $worksheet->getCell($col . $row)->getValue();
                        }
                        
                        try {
                            // 新的欄位順序:
                            // A:declaration_no, B:master_no, C:house_no, D:weight, E:total_packages, F:packages_in, G:packages_out, H:clearance_method, I:declaration_type, J:carrier_id, K:route, L:storage_in_datetime, M:storage_out_datetime, N:status, O:customer_name
                            $declaration_no = (string) $rowData[0];
                            $master_no = (string) $rowData[1];
                            $house_no = (string) $rowData[2];
                            
                            if (empty($master_no) || empty($house_no)) {
                                throw new Exception("主號(master_no) 和 分號(house_no) 不可為空");
                            }

                            // 資料清理與格式轉換
                            $weight = !empty($rowData[3]) ? floatval($rowData[3]) : 0;
                            $total_packages = !empty($rowData[4]) ? intval($rowData[4]) : 0;
                            $packages_in = !empty($rowData[5]) ? intval($rowData[5]) : 0;
                            $packages_out = !empty($rowData[6]) ? intval($rowData[6]) : 0;
                            $clearance_method = (string) $rowData[7];
                            $declaration_type = (string) $rowData[8];
                            $carrier_id = (string) $rowData[9];
                            $route = (string) $rowData[10];
                            $customer_name = (string) $rowData[14];

                            // 日期處理與狀態自動判斷
                            $storage_in = parse_date_value($rowData[11]);
                            $storage_out = parse_date_value($rowData[12]);
                            $status = (string) $rowData[13]; // 原始狀態

                            if (!empty($storage_out)) {
                                $status = "已出倉"; // 自動更新狀態
                            }

                            // 檢查記錄是否存在
                            $check_stmt->bind_param("ss", $master_no, $house_no);
                            $check_stmt->execute();
                            $result = $check_stmt->get_result();
                            
                            if ($result->num_rows > 0) {
                                // --- 更新 (UPDATE) ---
                                $update_stmt->bind_param(
                                    "sdiiissssssssss",
                                    $declaration_no, $weight, $total_packages, $packages_in, $packages_out,
                                    $clearance_method, $declaration_type, $carrier_id, $route,
                                    $storage_in, $storage_out, $status, $customer_name,
                                    $master_no, $house_no // WHERE 條件
                                );
                                if (!$update_stmt->execute()) { throw new Exception($update_stmt->error); }
                                $updated_rows++;
                            } else {
                                // --- 新增 (INSERT) ---
                                $insert_stmt->bind_param(
                                    "ssdiiisssssssss",
                                    $declaration_no, $master_no, $house_no,
                                    $weight, $total_packages, $packages_in, $packages_out,
                                    $clearance_method, $declaration_type, $carrier_id, $route,
                                    $storage_in, $storage_out, $status, $customer_name
                                );
                                if (!$insert_stmt->execute()) { throw new Exception($insert_stmt->error); }
                                $inserted_rows++;
                            }

                        } catch (Exception $rowException) {
                            // 記錄給使用者的錯誤訊息
                            $import_errors[] = "第 {$row} 行資料處理失敗: " . htmlspecialchars($rowException->getMessage());
                        }
                    }
                    
                    // 根據是否有錯誤決定提交或還原
                    if (empty($import_errors)) {
                        $conn->commit();
                        $user_message = "檔案 '" . $file_name . "' 處理完成。<br>新增 " . $inserted_rows . " 筆資料，更新 " . $updated_rows . " 筆資料。";
                        $message_type = 'success';
                    } else {
                        $conn->rollback();
                        $user_message = "檔案 '" . $file_name . "' 匯入失敗，所有操作已還原。<br>共發現 " . count($import_errors) . " 筆錯誤，請修正後再試。";
                        $message_type = 'error';
                        // 將詳細錯誤寫入日誌
                        write_log("File import failed for '{$file_name}'. Errors: " . implode(" | ", $import_errors));
                    }

                } catch (Exception $e) {
                    $conn->rollback();
                    $error_msg = "匯入過程發生嚴重錯誤: " . $e->getMessage();
                    write_log($error_msg);
                    $user_message = "系統發生嚴重錯誤，匯入已中斷並還原。請聯繫管理員。";
                    $message_type = 'error';
                } finally {
                    if (isset($check_stmt)) $check_stmt->close();
                    if (isset($insert_stmt)) $insert_stmt->close();
                    if (isset($update_stmt)) $update_stmt->close();
                    $conn->close();
                }
            }
        }
    } elseif (isset($_FILES['tax_file']) && $_FILES['tax_file']['error'] == UPLOAD_ERR_OK) {
        $user_message = "已收到稅金資料檔案，但尚未實作處理邏輯。";
        $message_type = 'info';
    } elseif ($_SERVER["REQUEST_METHOD"] == "POST") {
        $user_message = '請選擇一個有效的檔案上傳。';
        $message_type = 'warn';
    }
}
?>
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
