<?xml version="1.0" encoding="utf-8"?>
<modification>
	<name>Admin Checkbox Instead of Selection</name>
	<code>admin_checkbox_instead_of_selection</code>
	<version>2020.07.07</version>
	<author>OSEC.tw</author>
	<link>https://www.osec.tw</link>

	<file path="admin/controller/catalog/attribute.php">
		<operation error="log">
			<search><![CDATA[$sort = 'ad.name';]]></search>
			<add position="replace"><![CDATA[$sort = 'a.sort_order';]]></add>
		</operation>
	</file>
	<file path="admin/controller/catalog/filter.php">
		<operation error="log">
			<search><![CDATA[$sort = 'fgd.name';]]></search>
			<add position="replace"><![CDATA[$sort = 'fg.sort_order';]]></add>
		</operation>
	</file>

	<file path="admin/controller/catalog/product.php">
		<operation error="log">
			<search><![CDATA[$data['product_categories'] = array();]]></search>
			<add position="before"><![CDATA[
		$filter = array(
			'sort'		=> 'name',
			'order'		=> 'ASC',
		);
		$results = $this->model_catalog_category->getCategories($filter);
		foreach ($results as $result) {
			$check = "";
			if (in_array($result['category_id'], $categories)) {
				$check = "checked";
			}
			$categories_tree[] = array(
				'category_id'	=> $result['category_id'],
				'name'			=> strip_tags(html_entity_decode($result['name'], ENT_QUOTES, 'UTF-8')),
				'check'			=> $check
			);
		}
		$data['categories_tree'] = $categories_tree;
			]]></add>
		</operation>

		<operation error="log">
			<search><![CDATA[$data['product_filters'] = array();]]></search>
			<add position="before"><![CDATA[
		$filter = array(
			'sort'		=> 'f.sort_order',
			'order'	    => 'ASC',
		);
		$filters_tree = array();
		$results = $this->model_catalog_filter->getFilters($filter);
		foreach ($results as $result) {
			$check = "";
			if (in_array($result['filter_id'], $filters)) {
				$check = "checked";
			}
			$filters_tree[] = array(
				'filter_id'   => $result['filter_id'],
				'name'		  => strip_tags(html_entity_decode($result['group'], ENT_QUOTES, 'UTF-8')) . '&nbsp;&nbsp;>&nbsp;&nbsp;' . strip_tags(html_entity_decode($result['name'], ENT_QUOTES, 'UTF-8')),
				'check'		  => $check
			);
		}
		$data['filters_tree'] = $filters_tree;
			]]></add>
		</operation>
	</file>

	<file path="admin/view/template/catalog/product_form.twig">
		<operation error="log">
			<search><![CDATA[{{ entry_category }}</span></label>]]></search>
			<add position="replace" offset = "7"><![CDATA[
			{{ entry_category }}</span></label>
				<div class="col-sm-10">
					<div id="product-category" class="well well-sm" style="height: 300px; overflow: auto;"> {% for category in categories_tree %}
					  <div id="product-category{{ category.category_id }}">
						<input type="checkbox" name="product_category[]" {{ category.check }} value="{{ category.category_id }}"> {{ category.name }}<br>
					  </div>
					{% endfor %}</div>
			]]></add>
		</operation>
		<operation error="log">
			<search><![CDATA[{{ entry_filter }}</span></label>]]></search>
			<add position="replace" offset = "7"><![CDATA[
			{{ entry_filter }}</span></label>
				<div class="col-sm-10">
					<div id="product-filter" class="well well-sm" style="height: 300px; overflow: auto;"> {% for filter in filters_tree %}
					  <div id="product-filter{{ filter.filter_id }}">
						<input type="checkbox" name="product_filter[]" {{ filter.check }} value="{{ filter.filter_id }}"> {{ filter.name }}<br>
					  </div>
					{% endfor %}</div>
			]]></add>
		</operation>

